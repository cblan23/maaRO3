{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.invalid/maaRO3/evidence-manifest.schema.json",
    "title": "maaRO3 video evidence manifest",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "source_id",
        "primary_url",
        "capture_url",
        "captured_at",
        "test_context",
        "frames"
    ],
    "properties": {
        "schema_version": { "const": 1 },
        "source_id": { "type": "string", "minLength": 1 },
        "primary_url": { "type": "string", "format": "uri" },
        "capture_url": { "type": "string", "format": "uri" },
        "bvid": { "type": "string", "pattern": "^BV[0-9A-Za-z]{10}$" },
        "cid": { "type": "string", "minLength": 1 },
        "source_title": { "type": "string", "minLength": 1 },
        "source_author": { "type": "string", "minLength": 1 },
        "source_published_at": { "type": "string", "format": "date-time" },
        "captured_at": { "type": "string", "format": "date" },
        "test_context": { "type": "string", "minLength": 1 },
        "copyright_note": { "type": "string", "minLength": 1 },
        "frames": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "file",
                    "timestamp_seconds",
                    "sha256",
                    "dimensions",
                    "supports",
                    "limitations",
                    "recheck_in_cn_test"
                ],
                "properties": {
                    "file": { "type": "string", "pattern": "^frames/.+\\.(png|jpg|jpeg)$" },
                    "timestamp_seconds": { "type": "number", "minimum": 0 },
                    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                    "dimensions": {
                        "type": "array",
                        "prefixItems": [
                            { "type": "integer", "minimum": 1 },
                            { "type": "integer", "minimum": 1 }
                        ],
                        "minItems": 2,
                        "maxItems": 2
                    },
                    "supports": {
                        "type": "array",
                        "minItems": 1,
                        "items": { "type": "string", "minLength": 1 }
                    },
                    "limitations": {
                        "type": "array",
                        "minItems": 1,
                        "items": { "type": "string", "minLength": 1 }
                    },
                    "recheck_in_cn_test": { "type": "boolean" }
                }
            }
        }
    }
}
