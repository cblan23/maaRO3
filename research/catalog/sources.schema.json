{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.invalid/maaRO3/sources.schema.json",
    "title": "maaRO3 research source catalog",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_version", "game", "last_reviewed", "sources"],
    "properties": {
        "schema_version": { "const": 1 },
        "game": { "type": "string", "minLength": 1 },
        "last_reviewed": { "type": "string", "format": "date" },
        "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "kind", "grade", "status", "title", "url", "tags"],
                "properties": {
                    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
                    "kind": { "type": "string", "minLength": 1 },
                    "grade": { "enum": ["A", "B", "C", "D"] },
                    "status": { "type": "string", "minLength": 1 },
                    "title": { "type": "string", "minLength": 1 },
                    "url": { "type": "string", "format": "uri", "pattern": "^https://" },
                    "primary_url": { "type": "string", "format": "uri", "pattern": "^https://" },
                    "video_url": { "type": "string", "format": "uri", "pattern": "^https://" },
                    "primary_author": { "type": "string", "minLength": 1 },
                    "published_at": { "type": "string", "minLength": 10 },
                    "effective_at": { "type": "string", "format": "date" },
                    "duration_seconds": { "type": "integer", "minimum": 1 },
                    "tags": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
                    }
                }
            }
        }
    }
}
